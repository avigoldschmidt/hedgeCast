BANK_PROVIDER=nessie
NESSIE_API_KEY=

# Hedges fill against the live Kalshi order book on paper by default (exchange demo account can't be funded).
# Set HEDGE_MODE=live only with a funded Kalshi account and matching keys below.
HEDGE_MODE=paper

# Market data comes from Kalshi's public production API. No key needed.
KALSHI_DATA_URL=https://external-api.kalshi.com/trade-api/v2

# Only used when HEDGE_MODE=live. Demo and production keys are not interchangeable.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi-demo.key
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2

# HEDGECAST_FAKES=1 swaps Kalshi and Nessie for in-memory fakes (offline demos and tests).
HEDGECAST_FAKES=0
# The settlement worker checks open policies every 60 seconds.
HEDGECAST_WORKER=1
# HEDGECAST_V2_DB=backend/hedgecast.db

# Setup
#   python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
#   cd frontend && npm install
# Run
#   make api      # FastAPI on :8000 (real Kalshi data + Nessie)
#   make demo     # FastAPI on :8000 with fakes, no keys needed
#   make web      # React app on :5173
# Verify
#   make check    # pytest + typecheck + lint
#   make e2e      # Playwright happy path in Chrome
#   make smoke    # real Nessie + live Kalshi prices, paper hedge
